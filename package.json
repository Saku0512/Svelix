{
  "name": "svelix",
  "version": "0.1.0",
  "description": "A small, composable, native-first UI component library for Svelte 5.",
  "keywords": [
    "svelte",
    "svelte5",
    "components",
    "ui",
    "accessibility"
  ],
  "author": "Saku0512",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saku0512/Svelix.git"
  },
  "bugs": {
    "url": "https://github.com/Saku0512/Svelix/issues"
  },
  "homepage": "https://github.com/Saku0512/Svelix#readme",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run test:theme && npm run test:components && npm run test:ssr && npm run test:bundle && npm run test:release && npm run test:package",
    "test:components": "node tests/components.mjs",
    "test:theme": "node tests/theme.mjs",
    "test:ssr": "node tests/ssr.mjs",
    "test:bundle": "node tests/bundle.mjs",
    "test:release": "node tests/release-policy.test.mjs",
    "test:package": "node tests/package-consumer.mjs",
    "test:package:clean": "node tests/package-clean.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.59.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "svelte": "^5.59.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.4.0"
  }
}
