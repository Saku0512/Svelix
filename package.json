{
  "name": "svelix",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:components": "node tests/components.mjs",
    "test:theme": "node tests/theme.mjs",
    "test:package": "node tests/package-consumer.mjs",
    "test:package:clean": "node tests/package-clean.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.4.0"
  }
}
